{
  "version": 2,
  "buildCommand": "cd aureon-os && npm install && npm run build",
  "outputDirectory": "aureon-os/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://seu-backend.render.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VITE_API_BASE_URL": "/api"
  }
}
