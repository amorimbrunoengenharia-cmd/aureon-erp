{
  "name": "aureon-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite --debug --force",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist node_modules/.vite coverage simulator/reports",
    "clean:full": "rimraf dist node_modules coverage simulator/reports && npm install",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "simulate": "node scripts/simulate.js",
    "simulate:smoke": "node scripts/simulate.js --suite=critical --timeout=60000",
    "simulate:full": "node scripts/simulate.js --suite=all --parallel=10 --report=html",
    "simulate:sales": "node scripts/simulate.js --suite=sales",
    "simulate:concurrency": "node scripts/simulate.js --suite=concurrency --parallel=20",
    "simulate:dry-run": "node scripts/simulate.js --suite=critical --dry-run",
    "simulate:legacy": "node scripts/simulate-smoke.js",
    "validate": "npm run lint && npm run format:check && npm run test:ci",
    "prepare": "node -e \"try { require('husky').install() } catch (e) { if (e.code !== 'MODULE_NOT_FOUND') throw e }\"",
    "setup": "npm install && npm run prepare"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.12.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.5.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.22",
    "chalk": "^5.6.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "express": "^4.21.2",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.35",
    "rollup-plugin-visualizer": "^6.0.5",
    "seedrandom": "^3.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^5.1.6",
    "vitest": "^4.0.15"
  }
}
