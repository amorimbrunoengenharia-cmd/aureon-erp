# npm configuration for AUREON ERP
# https://docs.npmjs.com/cli/v9/configuring-npm/npmrc

# Save dependencies with exact versions (no ^ or ~)
save-exact=true

# Prefer offline mode (use cache when available)
prefer-offline=true

# Always use package-lock.json
package-lock=true

# Automatically install peer dependencies
legacy-peer-deps=false

# Update package-lock.json when dependencies change
package-lock-only=false

# Progress bar in CI
progress=true

# Audit level (low, moderate, high, critical, none)
audit-level=moderate

# Fund messages (show/hide)
fund=false

# Optional dependencies behavior
optional=true

# Engine strict (enforce engines in package.json)
engine-strict=false

# Save prefix (empty for exact versions)
save-prefix=

# Production flag for CI
# production=true

# Registry (use default npm registry)
# registry=https://registry.npmjs.org/

# Cache directory (optional, defaults to ~/.npm)
# cache=/path/to/cache

# Logs directory
# logs-dir=/path/to/logs
