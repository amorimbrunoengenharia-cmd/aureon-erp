# ================================
# AUREON ERP - Production Environment
# ================================

# Environment
NODE_ENV=production

# Server
PORT=5000
API_URL=https://api.aureon.com
FRONTEND_URL=https://aureon.com

# Database (PostgreSQL)
USE_POSTGRES=true
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aureon_production
DB_USER=aureon_production
DB_PASSWORD=CHANGE_ME_production_db_password_ULTRA_SECURE_123

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_production_redis_password_ULTRA_SECURE_456

# JWT Authentication
JWT_SECRET=CHANGE_ME_production_jwt_secret_ULTRA_SECURE_very_long_key_789
JWT_REFRESH_SECRET=CHANGE_ME_production_refresh_secret_ULTRA_SECURE_very_long_key_012
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=CHANGE_ME_sendgrid_api_key
EMAIL_FROM=noreply@aureon.com
EMAIL_FROM_NAME=AUREON ERP

# CORS
CORS_ORIGIN=https://aureon.com,https://www.aureon.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/production.log

# Feature Flags
ENABLE_SWAGGER=false
ENABLE_TRACE_ID=true

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DATADOG_API_KEY=your-datadog-api-key

# Backup Configuration
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_SCHEDULE=0 2 * * *

# Security
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true

# Performance
COMPRESSION_ENABLED=true
CACHE_TTL=3600

# Docker Registry
DOCKER_REGISTRY=registry.aureon.com
