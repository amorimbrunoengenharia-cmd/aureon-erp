# ===== APPLICATION =====
NODE_ENV=development
PORT=5000

# ===== DATABASE =====
# Set to 'true' to use PostgreSQL, 'false' for SQLite
USE_POSTGRES=false

# PostgreSQL Configuration (only if USE_POSTGRES=true)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aureon_erp
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# PostgreSQL SSL (recommended for production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_MIN=5

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# API Keys (External Services)
OPENAI_API_KEY=your_openai_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# Mercado Livre OAuth (REVOKE AND REGENERATE IN PRODUCTION)
ML_CLIENT_ID=your_ml_client_id
ML_CLIENT_SECRET=your_ml_client_secret
ML_REDIRECT_URI=http://localhost:5173/mercado-livre/callback

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/aureon.log

# Event System
EVENT_RETENTION_DAYS=90
DLQ_MAX_RETRIES=3
DLQ_RETRY_DELAY_MS=1000

# Email Configuration (SMTP)
# Option 1: Gmail (Free, 500 emails/day)
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Use 16-digit App Password as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NAME=AUREON ERP
SMTP_FROM=seu-email@gmail.com

# Option 2: SendGrid (Free tier: 100 emails/day)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key
# SMTP_FROM_NAME=AUREON ERP
# SMTP_FROM=noreply@seudominio.com

# ===== MARKETPLACE ENCRYPTION =====
# AES-256 encryption key for marketplace credentials (32 bytes hex)
MARKETPLACE_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here_change_in_production

# ===== ERROR MONITORING =====
# Sentry (Free tier: 5k events/month)
# 1. Create account: https://sentry.io/signup/
# 2. Create new project (Node.js)
# 3. Copy DSN from Settings -> Client Keys
# NOTE: DSN is hardcoded in instrument.mjs for immediate initialization
# Sentry is disabled in development mode by default (see instrument.mjs)
SENTRY_DSN=https://e372ed2ca282008b5ac271f268a40ec5@o4510500156014592.ingest.us.sentry.io/4510500158439424
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENABLED=false

# ===== SECURITY =====
# Session secret
SESSION_SECRET=your_session_secret_change_in_production

# Trust proxy (if behind nginx/load balancer)
TRUST_PROXY=false

# Force HTTPS redirect
FORCE_HTTPS=false

# ===== FEATURE FLAGS =====
ENABLE_AUDIT_LOG=true
ENABLE_MARKETPLACE_SYNC=true
ENABLE_EMAIL_NOTIFICATIONS=true

# ===== BACKUP =====
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
