# ================================
# AUREON ERP - Staging Environment
# ================================

# Environment
NODE_ENV=staging

# Server
PORT=5000
API_URL=https://staging-api.aureon.com
FRONTEND_URL=https://staging.aureon.com

# Database (PostgreSQL)
USE_POSTGRES=true
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aureon_staging
DB_USER=aureon_staging
DB_PASSWORD=CHANGE_ME_staging_db_password_123

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_staging_redis_password_123

# JWT Authentication
JWT_SECRET=CHANGE_ME_staging_jwt_secret_key_very_long_and_secure_123
JWT_REFRESH_SECRET=CHANGE_ME_staging_refresh_secret_key_very_long_and_secure_456
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=staging@aureon.com
SMTP_PASS=CHANGE_ME_smtp_password
EMAIL_FROM=staging@aureon.com
EMAIL_FROM_NAME=AUREON ERP Staging

# CORS
CORS_ORIGIN=https://staging.aureon.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/staging.log

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_TRACE_ID=false

# Docker Registry (optional)
DOCKER_REGISTRY=registry.aureon.com

# Monitoring (optional)
SENTRY_DSN=
DATADOG_API_KEY=
