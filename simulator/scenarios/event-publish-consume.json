{
  "id": "event-publish-consume",
  "name": "Publicação e consumo de eventos",
  "description": "Valida que eventos são publicados no EventBus e consumidos corretamente pelos workers",
  "priority": "XS",
  "tags": ["events", "critical", "eventbus"],
  "preconditions": {
    "services": ["backend"],
    "db_seed": "base.sql"
  },
  "steps": [
    {
      "type": "api",
      "action": "POST /auth/login",
      "params": {
        "body": {
          "username": "ceo",
          "password": "ceo123"
        }
      },
      "capture": ["body.accessToken as token"]
    },
    {
      "type": "event",
      "action": "publish test.event",
      "params": {
        "payload": {
          "test_id": "sim-001",
          "timestamp": "{{now}}",
          "data": "test payload"
        }
      },
      "capture": ["id as eventId"]
    },
    {
      "type": "wait",
      "params": {
        "ms": 500
      }
    },
    {
      "type": "event",
      "action": "wait_for test.event.processed",
      "params": {
        "timeout": 5000
      }
    },
    {
      "type": "api",
      "action": "GET /events/history",
      "params": {
        "headers": {
          "Authorization": "Bearer {{token}}"
        }
      },
      "expected": {
        "status": 200
      }
    }
  ],
  "assertions": [
    {
      "type": "event_count",
      "condition": {
        "event_type": "test.event",
        "min": 1,
        "max": 1
      },
      "failure_message": "Exactly 1 test.event should be published"
    },
    {
      "type": "event_exists",
      "condition": {
        "event_type": "test.event.processed"
      },
      "failure_message": "Event test.event.processed should be published after processing"
    },
    {
      "type": "db_exists",
      "condition": {
        "table": "event_logs",
        "where": {
          "event_type": "test.event"
        }
      },
      "failure_message": "Event should be logged in event_logs table"
    }
  ],
  "artifacts_to_collect": [
    "event_log",
    "api_log",
    "db_snapshot"
  ]
}
