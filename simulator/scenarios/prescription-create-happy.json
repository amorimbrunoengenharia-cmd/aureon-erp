{
  "id": "prescription-create-happy",
  "name": "Prescrição: Criação Completa (Happy Path)",
  "description": "Cria prescrição completa com validações, patient history e event tracking",
  "priority": "XS",
  "tags": ["prescription", "critical", "happy-path"],
  "timeout": 30000,
  "preconditions": {
    "database": {
      "tables": ["prescriptions", "patient_history", "events", "clients"],
      "seedRequired": true
    },
    "services": {
      "api": true,
      "database": true
    }
  },
  "steps": [
    {
      "id": "create-client",
      "type": "api",
      "method": "POST",
      "url": "/api/clients",
      "payload": {
        "nome": "João da Silva",
        "email": "joao.silva@email.com",
        "telefone": "(11) 98765-4321",
        "cpf": "123.456.789-00",
        "lgpd_consentimento": true
      },
      "assertions": [
        { "path": "status", "operator": "equals", "expected": 201 },
        { "path": "data.id", "operator": "exists" },
        { "path": "data.nome", "operator": "equals", "expected": "João da Silva" }
      ],
      "captureVariables": {
        "cliente_id": "data.id"
      }
    },
    {
      "id": "create-prescription",
      "type": "api",
      "method": "POST",
      "url": "/api/prescriptions",
      "payload": {
        "cliente_id": "{{cliente_id}}",
        "cliente_nome": "João da Silva",
        "od": {
          "esferico": -2.5,
          "cilindrico": -1.0,
          "eixo": 90,
          "dnp": 63.0,
          "adicao": 0
        },
        "oe": {
          "esferico": -2.75,
          "cilindrico": -0.75,
          "eixo": 85,
          "dnp": 62.5,
          "adicao": 0
        },
        "medico_nome": "Dr. Carlos Mendes",
        "medico_crm": "123456",
        "medico_uf": "SP",
        "tipo_lente": "Monofocal",
        "data_emissao": "2025-12-09",
        "observacoes": "Paciente reporta visão embaçada à distância",
        "lgpd_consentimento": true
      },
      "assertions": [
        { "path": "status", "operator": "equals", "expected": 201 },
        { "path": "data.id", "operator": "exists" },
        { "path": "data.trace_id", "operator": "exists" },
        { "path": "data.cliente_id", "operator": "equals", "expected": "{{cliente_id}}" },
        { "path": "data.od.esferico", "operator": "equals", "expected": -2.5 },
        { "path": "data.oe.esferico", "operator": "equals", "expected": -2.75 },
        { "path": "data.status", "operator": "equals", "expected": "ativa" }
      ],
      "captureVariables": {
        "prescription_id": "data.id",
        "trace_id": "data.trace_id"
      }
    },
    {
      "id": "verify-patient-history",
      "type": "api",
      "method": "GET",
      "url": "/api/prescriptions/patients/{{cliente_id}}/history",
      "assertions": [
        { "path": "status", "operator": "equals", "expected": 200 },
        { "path": "data.length", "operator": "greaterThan", "expected": 0 },
        { "path": "data[0].event_type", "operator": "equals", "expected": "prescription" },
        { "path": "data[0].patient_id", "operator": "equals", "expected": "{{cliente_id}}" },
        { "path": "data[0].related_id", "operator": "equals", "expected": "{{prescription_id}}" },
        { "path": "data[0].trace_id", "operator": "equals", "expected": "{{trace_id}}" }
      ]
    },
    {
      "id": "verify-event-created",
      "type": "api",
      "method": "GET",
      "url": "/api/events?trace_id={{trace_id}}",
      "assertions": [
        { "path": "status", "operator": "equals", "expected": 200 },
        { "path": "data.length", "operator": "greaterThan", "expected": 0 },
        { "path": "data[0].event_type", "operator": "equals", "expected": "prescription.created" },
        { "path": "data[0].trace_id", "operator": "equals", "expected": "{{trace_id}}" },
        { "path": "data[0].status", "operator": "equals", "expected": "completed" }
      ]
    },
    {
      "id": "get-prescription",
      "type": "api",
      "method": "GET",
      "url": "/api/prescriptions/{{prescription_id}}",
      "assertions": [
        { "path": "status", "operator": "equals", "expected": 200 },
        { "path": "data.id", "operator": "equals", "expected": "{{prescription_id}}" },
        { "path": "data.cliente_id", "operator": "equals", "expected": "{{cliente_id}}" }
      ]
    }
  ],
  "teardown": {
    "cleanupDatabase": false,
    "note": "Keep data for inspection"
  },
  "expectedOutcome": {
    "prescriptionsCreated": 1,
    "patientHistoryEntries": 1,
    "eventsCreated": 1
  }
}
