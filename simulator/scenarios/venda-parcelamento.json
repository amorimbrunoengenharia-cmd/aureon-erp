{
  "id": "venda-parcelamento",
  "name": "Venda com parcelamento",
  "description": "Valida venda parcelada em cartão de crédito",
  "priority": "S",
  "tags": ["sales", "payment"],
  "preconditions": {
    "services": ["backend"],
    "db_seed": "base.sql"
  },
  "steps": [
    {
      "type": "api",
      "action": "POST /auth/login",
      "params": {
        "body": {
          "username": "vendedor",
          "password": "vendedor123"
        }
      },
      "capture": ["body.accessToken as token"]
    },
    {
      "type": "api",
      "action": "GET /produtos",
      "params": {
        "headers": {
          "Authorization": "Bearer {{token}}"
        }
      },
      "capture": ["body.data[0].id as productId"]
    },
    {
      "type": "api",
      "action": "GET /clientes",
      "params": {
        "headers": {
          "Authorization": "Bearer {{token}}"
        }
      },
      "capture": ["body.data[0].id as clientId"]
    },
    {
      "type": "api",
      "action": "POST /vendas",
      "params": {
        "headers": {
          "Authorization": "Bearer {{token}}"
        },
        "body": {
          "cliente_id": "{{clientId}}",
          "items": [
            {
              "produto_id": "{{productId}}",
              "quantidade": 1,
              "preco_unitario": 300.00
            }
          ],
          "pagamento": {
            "metodo": "CARTAO_CREDITO",
            "valor_pago": 300.00,
            "parcelas": 3
          }
        }
      },
      "expected": {
        "status": 201,
        "body.pagamento.parcelas": 3
      },
      "capture": ["body.id as saleId"]
    }
  ],
  "assertions": [
    {
      "type": "db_count",
      "condition": {
        "table": "parcelas",
        "where": {
          "venda_id": "{{saleId}}"
        },
        "operator": "equals",
        "expected": 3
      },
      "failure_message": "Devem existir 3 parcelas"
    },
    {
      "type": "db_value",
      "condition": {
        "table": "parcelas",
        "column": "valor",
        "where": {
          "venda_id": "{{saleId}}"
        },
        "operator": "equals",
        "expected": 100.00
      },
      "failure_message": "Cada parcela deve ser 100.00"
    }
  ],
  "artifacts_to_collect": ["db_snapshot", "api_log"]
}
