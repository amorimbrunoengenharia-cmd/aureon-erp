# .gitattributes - Git attributes for AUREON ERP
# https://git-scm.com/docs/gitattributes

# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Configuration
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
.env* text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Docker
Dockerfile text eol=lf
*.dockerignore text eol=lf
docker-compose*.yml text eol=lf

# CI/CD
.github/** text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Lock files (generated, should not be modified)
package-lock.json binary
yarn.lock binary
pnpm-lock.yaml binary

# Git LFS (Large File Storage) - if needed in the future
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.ai filter=lfs diff=lfs merge=lfs -text

# Custom diff drivers for better diffs
*.json diff=json
*.md diff=markdown
package.json diff=json
package-lock.json -diff

# Export-ignore (files not included in git archive)
.github/ export-ignore
.vscode/ export-ignore
tests/ export-ignore
simulator/ export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.editorconfig export-ignore
.prettierrc export-ignore
.prettierignore export-ignore
.eslintrc.* export-ignore
vitest.config.js export-ignore
playwright.config.js export-ignore
setup.sh export-ignore
setup.ps1 export-ignore
*.test.js export-ignore
*.spec.js export-ignore
*.test.jsx export-ignore
*.spec.jsx export-ignore

# Linguist overrides (for GitHub language stats)
# Exclude vendor and generated files from stats
simulator/reports/** linguist-generated
dist/** linguist-generated
coverage/** linguist-generated
*.min.js linguist-generated
*.min.css linguist-generated

# Mark documentation
*.md linguist-documentation

# Vendored code (if any)
# vendor/** linguist-vendored
